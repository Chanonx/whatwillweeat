# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจาก Supabase → Project Settings → API Keys

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) — เปิดเผยได้
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) — ห้ามเปิดเผย ห้าม commit!
SUPABASE_SERVICE_ROLE_KEY=

# (ไม่บังคับ) โหมดทดสอบในเครื่อง: login ด้วยชื่ออะไรก็ได้ ไม่ต้องผ่าน Google
# ใช้ได้เฉพาะ `npm run dev` — บน production ปิดอัตโนมัติ
# DEV_FAKE_AUTH=1
# NEXT_PUBLIC_DEV_FAKE_AUTH=1
